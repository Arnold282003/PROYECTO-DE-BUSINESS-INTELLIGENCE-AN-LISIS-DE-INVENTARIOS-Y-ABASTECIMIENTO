table Calendario
	lineageTag: 44f4e3f0-ad44-4a22-aa12-09f1c02d801a
	dataCategory: Time

	column fecha
		dataType: dateTime
		isKey
		formatString: dd/MM/yyyy
		lineageTag: 1effd3d3-7b76-48e0-91e7-9fcda16a5a3d
