		lineageTag: 2bdbc04a-13a3-4a3e-b329-fa257b2f554b
		summarizeBy: none
		sourceColumn: anio

	column mes
		dataType: int64
		lineageTag: 45003e6d-2d23-4acd-8626-e48ae289fae3
